{
  "name": "@eyra/mobile-tiktok",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && bash scripts/syntax-gate.sh",
    "preview": "vite preview --port 3100 --strictPort",
    "gate": "bash scripts/syntax-gate.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "cd ../python && poetry run python ../mobile-tiktok/fixtures/generate.py",
    "test:e2e": "playwright test -c playwright.config.ts",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "30.0.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.5"
  }
}
